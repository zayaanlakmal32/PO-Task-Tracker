# Notion internal integration token (Notion -> Settings -> Connections -> Develop or manage integrations)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Data source IDs (the UUID after "collection://" when you fetch a database).
# Client_Task Tracker -> https://app.notion.com/p/388b6494fc14805f9637ebbb647c5ede
NOTION_TASK_DATA_SOURCE_ID=9a0b6494-fc14-822c-93d3-876629f0be03

# Project Tracker -> https://app.notion.com/p/c16dfb55fcd8463baf560eddfc0eb214
NOTION_PROJECT_DATA_SOURCE_ID=b6b396fe-f0cf-4d7e-9845-e18c630c0ae7

# Weekly Snapshot Archive - leave blank until you run `npm run setup:notion`,
# which creates the archive database and prints the ID to paste here.
NOTION_ARCHIVE_DATA_SOURCE_ID=

# A parent Notion page ID the setup script can create the archive database under.
# Open any page you want it nested under, copy the ID from its URL (32-char hex after the last dash/slash).
NOTION_ARCHIVE_PARENT_PAGE_ID=

# Which week each task belongs to: "due_date" (default) buckets tasks by their Due date,
# "created" buckets by when the task row was created.
WEEK_BASIS=due_date

# Simple shared password to protect the dashboard (optional but recommended since it shows client data).
DASHBOARD_PASSWORD=
